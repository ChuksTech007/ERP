# Copy to .env.local and fill in.

# Where the shop's database file lives. Defaults to ./data/shop.db.
# On the shop machine this should be an absolute path on a drive that is
# actually backed up.
DATABASE_PATH=

# Signs the login cookie. Any long random string; changing it logs everyone
# out, which is the intended way to boot a departed staff member off a till.
AUTH_SECRET=

# The address other tills use to reach this machine over the shop router,
# e.g. http://192.168.0.10:3000 — used for links printed on tickets.
SHOP_URL=http://localhost:3000
